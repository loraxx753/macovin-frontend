# Base URL for macovin-backend (no trailing slash).
# Contact: POST {MACOVIN_API_BASE_URL}/api/contact
# Examples: GET  {MACOVIN_API_BASE_URL}/api/examples
#
# Local default (also used by webpack in development if unset):
MACOVIN_API_BASE_URL=http://localhost:3001
#
# Leave empty / unset in production builds to skip the API and use
# mailto + static example fallbacks only.
# MACOVIN_API_BASE_URL=

# Optional public path for production deploys (default /).
# ASSET_PATH=/
